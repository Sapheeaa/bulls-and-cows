{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "description": "Bulls and Cows game - functional programming TDD task",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sapheeaa/bulls-and-cows.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Sapheeaa/bulls-and-cows/issues"
  },
  "homepage": "https://github.com/Sapheeaa/bulls-and-cows#readme"
}
